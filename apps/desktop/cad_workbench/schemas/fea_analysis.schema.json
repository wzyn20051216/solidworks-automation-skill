{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadstudio.local/schemas/fea-analysis-1.1.json",
  "title": "CAD Studio FEA Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "analysisId", "analysisType", "solver", "units", "material", "mesh", "constraints", "loads"],
  "properties": {
    "schemaVersion": { "enum": ["1.0", "1.1"] },
    "analysisId": { "$ref": "#/$defs/id" },
    "analysisType": { "enum": ["static_linear", "static_nonlinear", "modal", "thermal_steady"] },
    "solver": { "enum": ["auto", "calculix", "elmer"] },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "force", "stress", "temperature"],
      "properties": {
        "length": { "const": "mm" },
        "force": { "const": "N" },
        "stress": { "const": "MPa" },
        "temperature": { "const": "C" }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "elasticModulusMPa", "poissonRatio", "densityKgM3"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "elasticModulusMPa": { "type": "number", "exclusiveMinimum": 0 },
        "poissonRatio": { "type": "number", "exclusiveMinimum": -1, "exclusiveMaximum": 0.5 },
        "densityKgM3": { "type": "number", "exclusiveMinimum": 0 },
        "conductivityWmK": { "type": "number", "exclusiveMinimum": 0 },
        "plasticCurve": {
          "type": "array", "minItems": 2, "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["yieldStressMPa", "plasticStrain"],
            "properties": {
              "yieldStressMPa": { "type": "number", "exclusiveMinimum": 0 },
              "plasticStrain": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "elements", "nodeSets", "elementSets"],
      "properties": {
        "nodes": {
          "type": "array", "minItems": 4, "maxItems": 1000000,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "x", "y", "z"],
            "properties": { "id": { "type": "integer", "minimum": 1 }, "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }
          }
        },
        "elements": {
          "type": "array", "minItems": 1, "maxItems": 500000,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "type", "nodeIds"],
            "properties": {
              "id": { "type": "integer", "minimum": 1 },
              "type": { "enum": ["C3D4", "C3D8"] },
              "nodeIds": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
            },
            "allOf": [
              { "if": { "properties": { "type": { "const": "C3D4" } } }, "then": { "properties": { "nodeIds": { "minItems": 4, "maxItems": 4 } } } },
              { "if": { "properties": { "type": { "const": "C3D8" } } }, "then": { "properties": { "nodeIds": { "minItems": 8, "maxItems": 8 } } } }
            ]
          }
        },
        "nodeSets": { "$ref": "#/$defs/sets" },
        "elementSets": { "$ref": "#/$defs/sets" }
      }
    },
    "constraints": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "type", "nodeSet"],
        "properties": {
          "id": { "$ref": "#/$defs/id" }, "type": { "enum": ["fixed", "displacement"] }, "nodeSet": { "$ref": "#/$defs/id" },
          "dof": { "type": "integer", "minimum": 1, "maximum": 3 }, "value": { "type": "number" }
        },
        "allOf": [{ "if": { "properties": { "type": { "const": "displacement" } } }, "then": { "required": ["dof", "value"] } }]
      }
    },
    "loads": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "type"],
        "properties": {
          "id": { "$ref": "#/$defs/id" }, "type": { "enum": ["force", "pressure", "gravity"] },
          "nodeSet": { "$ref": "#/$defs/id" }, "elementSet": { "$ref": "#/$defs/id" },
          "face": { "enum": ["P1", "P2", "P3", "P4", "P5", "P6"] },
          "dof": { "type": "integer", "minimum": 1, "maximum": 3 }, "value": { "type": "number" },
          "magnitude": { "type": "number", "exclusiveMinimum": 0 },
          "direction": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
        },
        "allOf": [
          { "if": { "properties": { "type": { "const": "force" } } }, "then": { "required": ["nodeSet", "dof", "value"] } },
          { "if": { "properties": { "type": { "const": "pressure" } } }, "then": { "required": ["elementSet", "face", "magnitude"] } },
          { "if": { "properties": { "type": { "const": "gravity" } } }, "then": { "required": ["magnitude", "direction"] } }
        ]
      }
    },
    "nonlinearControls": {
      "type": "object", "additionalProperties": false,
      "required": ["initialIncrement", "timePeriod", "minimumIncrement", "maximumIncrement", "maximumIncrements"],
      "properties": {
        "initialIncrement": { "type": "number", "exclusiveMinimum": 0 },
        "timePeriod": { "type": "number", "exclusiveMinimum": 0 },
        "minimumIncrement": { "type": "number", "exclusiveMinimum": 0 },
        "maximumIncrement": { "type": "number", "exclusiveMinimum": 0 },
        "maximumIncrements": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "surfaces": {
      "type": "object", "maxProperties": 64, "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["elementSet", "face"],
        "properties": {
          "elementSet": { "$ref": "#/$defs/id" },
          "face": { "enum": ["S1", "S2", "S3", "S4", "S5", "S6"] }
        }
      }
    },
    "contacts": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "masterSurface", "slaveSurface", "frictionCoefficient", "normalStiffnessMPaPerMm", "tangentialStickSlopeMPaPerMm"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "masterSurface": { "$ref": "#/$defs/id" },
          "slaveSurface": { "$ref": "#/$defs/id" },
          "frictionCoefficient": { "type": "number", "minimum": 0, "maximum": 2 },
          "normalStiffnessMPaPerMm": { "type": "number", "exclusiveMinimum": 0 },
          "tangentialStickSlopeMPaPerMm": { "type": "number", "minimum": 0 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "analysisType": { "const": "static_nonlinear" } }, "required": ["analysisType"] },
      "then": { "properties": { "schemaVersion": { "const": "1.1" } }, "required": ["nonlinearControls"] }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
    "sets": {
      "type": "object", "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } }
    }
  }
}
