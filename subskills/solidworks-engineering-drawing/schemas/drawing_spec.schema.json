{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SolidWorks Engineering DrawingSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceModel", "documentType", "standard", "projection", "paperSize", "modelSizeMm", "views", "outputs"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "sourceModel": { "type": "string", "minLength": 1 },
    "documentType": { "enum": ["part", "assembly", "sheet_metal"] },
    "standard": { "enum": ["GB_T", "ISO"] },
    "projection": { "enum": ["first_angle", "third_angle"] },
    "paperSize": { "enum": ["A4", "A3", "A2", "A1", "A0"] },
    "modelSizeMm": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "exclusiveMinimum": 0 } },
    "insertModelDimensions": { "type": "boolean" },
    "templateCandidates": { "type": "array", "items": { "type": "string" } },
    "views": {
      "type": "object",
      "required": ["front"],
      "additionalProperties": false,
      "properties": {
        "front": { "type": "object" },
        "top": { "type": "object" },
        "bottom": { "type": "object" },
        "left": { "type": "object" },
        "right": { "type": "object" },
        "isometric": { "type": "object" },
        "sections": { "type": "array", "items": { "type": "object" } },
        "details": { "type": "array", "items": { "type": "object" } }
      }
    },
    "scale": {
      "oneOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "string", "pattern": "^\\s*[0-9]+(?:\\.[0-9]+)?\\s*:\\s*[0-9]+(?:\\.[0-9]+)?\\s*$" }
      ]
    },
    "requiredDimensions": { "type": "array", "items": { "$ref": "#/$defs/dimension" } },
    "holeRequirements": { "type": "array", "items": { "$ref": "#/$defs/hole" } },
    "professionalAnnotations": { "$ref": "#/$defs/professionalAnnotations" },
    "titleBlock": { "type": "object" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "bom": { "type": "object" },
    "sheetMetal": { "type": "object" },
    "modelEvidence": { "type": "string" },
    "outputs": {
      "type": "object",
      "required": ["slddrw", "pdf", "report"],
      "additionalProperties": false,
      "properties": {
        "slddrw": { "type": "boolean" },
        "pdf": { "type": "boolean" },
        "bmp": { "type": "boolean" },
        "png": { "type": "boolean" },
        "report": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "required": ["id", "kind", "view"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["overall", "linear", "angular", "radius", "diameter", "tolerance", "datum", "gdt"] },
        "view": { "type": "string", "minLength": 1 },
        "valueMm": { "type": "number" },
        "text": { "type": "string" },
        "tolerance": { "type": "string" },
        "datum": { "type": "string" }
      },
      "additionalProperties": true
    },
    "hole": {
      "type": "object",
      "required": ["id", "specification", "count", "locationsMm"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "specification": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 },
        "locationsMm": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "number" } } },
        "view": { "type": "string" },
        "datum": { "type": "string" }
      },
      "additionalProperties": true
    },
    "professionalAnnotations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "centerMarks": { "type": "array", "items": { "$ref": "#/$defs/centerMarkAnnotation" } },
        "centerLines": { "type": "array", "items": { "$ref": "#/$defs/countAnnotation" } },
        "holeCallouts": { "type": "array", "items": { "$ref": "#/$defs/textAnnotation" } },
        "datums": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/textAnnotation"}, {"$ref": "#/$defs/datum"}]}},
        "geometricTolerances": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/textAnnotation"}, {"$ref": "#/$defs/gtol"}]}},
        "surfaceFinishSymbols": { "type": "array", "items": { "$ref": "#/$defs/textAnnotation" } },
        "weldSymbols": { "type": "array", "items": { "$ref": "#/$defs/textAnnotation" } }
      }
    },
    "countAnnotation": {
      "type": "object",
      "required": ["id", "view", "count"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "view": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "centerMarkAnnotation": {
      "type": "object",
      "required": ["id", "view", "count", "targets"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "view": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["holes", "fillets", "slots"] }
        }
      }
    },
    "textAnnotation": {
      "type": "object",
      "required": ["id", "view", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "view": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "label": {"type": "string", "pattern": "^[A-Z]{1,2}$"},
    "point": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1189}, {"type": "number", "minimum": 0, "maximum": 841}]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "startMm", "endMm"],
          "properties": {"kind": {"const": "line"}, "startMm": {"$ref": "#/$defs/point"}, "endMm": {"$ref": "#/$defs/point"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "centerMm", "radiusMm"],
          "properties": {"kind": {"const": "circle"}, "centerMm": {"$ref": "#/$defs/point"}, "radiusMm": {"type": "number", "exclusiveMinimum": 0}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "systemValue"],
          "properties": {"kind": {"const": "dimension"}, "name": {"type": "string", "minLength": 1, "maxLength": 512}, "systemValue": {"type": "number"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "dimensionId"],
          "properties": {"kind": {"const": "dimension"}, "dimensionId": {"$ref": "#/$defs/id"}}
        }
      ]
    },
    "datum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "view", "label", "positionMm", "displayStyle", "target"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "view": {"$ref": "#/$defs/id"},
        "label": {"$ref": "#/$defs/label"},
        "positionMm": {"$ref": "#/$defs/position"},
        "displayStyle": {"enum": ["square", "round_gb"]},
        "target": {"$ref": "#/$defs/target"}
      }
    },
    "gtol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "view", "target"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "view": {"$ref": "#/$defs/id"},
        "characteristic": {
          "enum": [
            "straightness",
            "flatness",
            "circularity",
            "cylindricity",
            "line_profile",
            "surface_profile",
            "parallelism",
            "perpendicularity",
            "angularity",
            "position",
            "concentricity",
            "symmetry",
            "circular_runout",
            "total_runout"
          ]
        },
        "tolerance": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "diameter": {"type": "boolean"},
        "datums": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/datumReference"}},
        "materialCondition": {"enum": [null, "M", "L", "S"]},
        "positionMm": {"$ref": "#/$defs/position"},
        "target": {"$ref": "#/$defs/target"},
        "frames": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/frame"}},
        "options": {"$ref": "#/$defs/gdtOptions"}
      },
      "oneOf": [
        {"required": ["characteristic", "tolerance", "diameter", "datums"], "not": {"required": ["frames"]}},
        {
          "required": ["frames"],
          "not": {
            "anyOf": [
              {"required": ["characteristic"]},
              {"required": ["tolerance"]},
              {"required": ["diameter"]},
              {"required": ["datums"]},
              {"required": ["materialCondition"]},
              {"required": ["options"]}
            ]
          }
        }
      ]
    },
    "datumReference": {
      "oneOf": [
        {"$ref": "#/$defs/label"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["label"],
          "properties": {
            "label": {"$ref": "#/$defs/label"},
            "materialCondition": {"enum": [null, "M", "L", "S"]},
            "modifiers": {"$ref": "#/$defs/datumModifiers"},
            "constraints": {"$ref": "#/$defs/datumConstraints"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["common"],
          "properties": {
            "common": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"$ref": "#/$defs/datumMember"}},
            "subDatums": {
              "type": "array",
              "minItems": 0,
              "maxItems": 3,
              "items": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"$ref": "#/$defs/datumMember"}}
            },
            "constraints": {"$ref": "#/$defs/datumConstraints"}
          }
        }
      ]
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["characteristic", "tolerance", "diameter", "datums"],
      "properties": {
        "characteristic": {
          "enum": [
            "straightness",
            "flatness",
            "circularity",
            "cylindricity",
            "line_profile",
            "surface_profile",
            "parallelism",
            "perpendicularity",
            "angularity",
            "position",
            "concentricity",
            "symmetry",
            "circular_runout",
            "total_runout"
          ]
        },
        "tolerance": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "diameter": {"type": "boolean"},
        "datums": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/datumReference"}},
        "materialCondition": {"enum": [null, "M", "L", "S"]},
        "composite": {"type": "boolean"},
        "options": {"$ref": "#/$defs/gdtOptions"}
      }
    },
    "datumModifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "situation": {"enum": ["plane", "straightLine", "point"]},
        "section": {"enum": ["cross", "longitudinal"]},
        "projection": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "freeState": {"type": "boolean"}
      }
    },
    "datumConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "translationX": {"type": "boolean"},
        "translationY": {"type": "boolean"},
        "translationZ": {"type": "boolean"},
        "rotationX": {"type": "boolean"},
        "rotationY": {"type": "boolean"},
        "rotationZ": {"type": "boolean"},
        "contactFeature": {"type": "boolean"},
        "orientationOnly": {"type": "boolean"},
        "variableDistance": {"type": "boolean"},
        "translation": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"}
        }
      }
    },
    "datumMember": {
      "oneOf": [
        {"$ref": "#/$defs/label"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["label"],
          "properties": {
            "label": {"$ref": "#/$defs/label"},
            "materialCondition": {"enum": [null, "M", "L", "S"]},
            "modifiers": {"$ref": "#/$defs/datumModifiers"}
          }
        }
      ]
    },
    "unitZone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["separator", "value"],
      "properties": {
        "separator": {"enum": ["/", "-"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "symbol": {"enum": ["none", "diameter", "sphericalDiameter", "square", "angle"]},
        "limit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["separator", "value"],
          "properties": {
            "separator": {"enum": ["X", "-"]},
            "value": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
            "symbol": {"enum": ["none", "diameter", "sphericalDiameter", "square", "angle"]}
          }
        }
      }
    },
    "maxTolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "diameter"],
      "properties": {
        "value": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "diameter": {"type": "boolean"}
      }
    },
    "profileZone": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "unequalOutside": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "offsets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["direction", "value"],
            "properties": {
              "direction": {"enum": ["outside", "inside"]},
              "value": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[0-9]+(?:\\.[0-9]+)?$"}
            }
          }
        },
        "dynamic": {"type": "boolean"},
        "combination": {"enum": ["CZ", "SZ"]},
        "constraints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"enum": ["offset", "angularOffset", "orientationOnly"]},
          "uniqueItems": true
        }
      },
      "minProperties": 1,
      "not": {"required": ["unequalOutside", "offsets"]}
    },
    "projectedZone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection"],
      "properties": {
        "projection": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "range": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[0-9]+(?:\\.[0-9]+)?$"}
      }
    },
    "gdtFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "cutOff"],
      "properties": {
        "symbol": {"enum": ["G", "S", "SW", "CW", "RG", "RS", "OB", "OH", "OD", "CB", "CH", "CD", "AB", "AH", "AD", "F", "H"]},
        "cutOff": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "shortWave": {"type": "boolean"},
        "longWave": {"type": "boolean"},
        "separator": {"enum": ["", "Space", "X"]},
        "second": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cutOff"],
          "properties": {
            "cutOff": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
            "shortWave": {"type": "boolean"},
            "longWave": {"type": "boolean"}
          }
        }
      }
    },
    "gdtOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "symbolLibrary": {"enum": ["iso", "asme", "gb"]},
        "zoneShape": {"enum": ["none", "diameter", "sphericalDiameter", "square"]},
        "unitZone": {"$ref": "#/$defs/unitZone"},
        "maxTolerance": {"$ref": "#/$defs/maxTolerance"},
        "profileZone": {"$ref": "#/$defs/profileZone"},
        "projectedZone": {"$ref": "#/$defs/projectedZone"},
        "associatedFeature": {"enum": ["Minimax", "LeastSquares", "MinimumCircumscribed", "Tangent", "MaximumInscribed"]},
        "derivedFeature": {"type": "boolean"},
        "filters": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/gdtFilter"}},
        "associatedCharacteristic": {"enum": ["C", "CE", "CI", "G", "GE", "GI", "X", "N"]},
        "parametricCharacteristic": {"enum": ["P", "V", "T", "Q"]},
        "reciprocity": {"type": "boolean"},
        "freeState": {"type": "boolean"},
        "statistical": {"type": "boolean"}
      }
    }
  }
}
